APP_ENV=development
DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5434/careeros
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOW_LOCAL_IDENTITY=true
# Optional during legacy rollout; agents always require versions.
REQUIRE_PROFILE_VERSION=false
# Defaults for owners without saved UI preferences
AGENT_RUNTIME_ALLOWED=true
AGENT_WORKER_EMBEDDED=true
AGENT_ENABLED=false
AGENT_INTERNAL_WRITES_ENABLED=false
AGENT_APPROVALS_ENABLED=false
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TURNS=8
AGENT_TIMEOUT_SECONDS=90
# Server only. Keep unset until a trusted provider is configured.
# LLM_BASE_URL=https://YOUR_PRIVATE_PROXY/v1
# LLM_MODEL=YOUR_MODEL
# LLM_API_KEY=YOUR_SECRET
DOCUMENT_MAX_BYTES=10485760
# DOCUMENT_STORAGE_DIR=D:/Private/CareerOS/documents
