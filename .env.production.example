# TEMPLATE ONLY - production.
# Copy to an ignored private env file and fill REPLACE_WITH_* privately.
# Backend defaults to .env; select .env.development via APP_ENV_FILE or --env-file.
# Compose selects .env.production via env_file; do NOT put APP_ENV_FILE in this file.
# Process environment overrides file values. No template migrates or copies data.
# Production worker support requires promoting/rebuilding the updated backend source.
# Production Compose still needs dispatcher/stats and replica/browser-mode alignment.
# Changing this template does not remove those application/deployment blockers.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://REPLACE_WITH_PRODUCTION_DB_USER:REPLACE_WITH_URL_ENCODED_PRODUCTION_DB_PASSWORD@REPLACE_WITH_PRODUCTION_DB_HOST:5432/REPLACE_WITH_PRODUCTION_DB_NAME?sslmode=require
# Native local PostgreSQL example uses port 5434; adjust to your local instance.
# A container reaching host PostgreSQL needs host.docker.internal, not localhost.
# For Supabase copy the direct/session connection from the intended project.
# Percent-encode reserved password characters; retain required TLS parameters.

API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["https://workspace.covryzne.dev"]
ALLOW_LOCAL_IDENTITY=false
LOCAL_AUTH_ENABLED=false
# Local accounts: true on backend and FE local mode. Google/Supabase: false on both.
REQUIRE_PROFILE_VERSION=false
JOB_MATCHING_ENABLED=false

# Selenium workers are separate from the optional AI agent worker.
# Agent features stay off; native crawler worker requires embedded agent=false.
AGENT_RUNTIME_ALLOWED=false
AGENT_WORKER_EMBEDDED=false
AGENT_ENABLED=false
AGENT_INTERNAL_WRITES_ENABLED=false
AGENT_APPROVALS_ENABLED=false
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TURNS=8
AGENT_TIMEOUT_SECONDS=90
# Optional trusted provider settings; never needed for server Selenium crawling.
# LLM_BASE_URL=https://REPLACE_WITH_PROVIDER_HOST/v1
# LLM_MODEL=REPLACE_WITH_MODEL_NAME
# LLM_API_KEY=REPLACE_WITH_PRIVATE_PROVIDER_KEY

# Keep the encryption key stable for this environment; do not rotate on redeploy.
PROVIDER_ENCRYPTION_KEY=REPLACE_WITH_VALID_PRODUCTION_FERNET_KEY
DOCUMENT_STORAGE_DIR=/data/careeros/documents
DOCUMENT_MAX_BYTES=10485760

# Native worker paths only. Compose supplies the internal paths in its own image.
# CRAWLER_ROOT=REPLACE_WITH_ABSOLUTE_CRAWLER_REPO_PATH
# CRAWLER_PYTHON=REPLACE_WITH_ABSOLUTE_CRAWLER_PYTHON_EXECUTABLE
CRAWLER_BROWSER_MODE=headless
# Choose auto/headed if that is the mode verified on your target portals/VM.
CRAWLER_RUN_TIMEOUT_SECONDS=3600
CRAWLER_LEASE_SECONDS=30
CRAWLER_ENABLED_PORTALS=linkedin,jobstreet,glints,dealls,kalibrr,techinasia
# Empty portal list disables new dashboard/API crawls; Indeed is excluded by default.
CRAWLER_MAX_CONCURRENCY=1
# Global running capacity (1..8). Each independent worker handles one run at a time.
# Crawler staging Compose reads this from the backend env passed via --env-file.
CRAWLER_WORKER_REPLICAS=1
# For a two-worker test set BOTH capacity and replicas=2; VM limits are per replica.
# Production Compose must gain replica wiring before this value takes effect.

# Statistics: reuse the coverage date already stored in crawler_stats_publications.
# For an empty database choose the first retained-history WIB date deliberately.
# Compose --profile analytics injects this variable into the publisher process.
# Native publisher: pass --coverage-start YYYY-MM-DD or export the process variable;
# selecting APP_ENV_FILE alone does not export extra dotenv keys to os.environ.
# CRAWLER_STATS_COVERAGE_START=YYYY-MM-DD

# Auth: BE and FE must use the same Supabase Auth project for this environment.
# Requires ES256/RS256 signing keys. Google Client Secret stays in Supabase Auth.
SUPABASE_URL=https://REPLACE_WITH_PRODUCTION_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# JWKS URL is derived from SUPABASE_URL; normally leave it unset.
# AUTH_JWKS_TIMEOUT_SECONDS=5
# AUTH_JWKS_CACHE_SECONDS=300
# Backend JWT verification does not use Supabase publishable/service-role keys.
