# TEMPLATE ONLY - staging; replace REPLACE_WITH_* before use.
# Real values: your vault -> process environment or ignored private env file.
# Vault references are NOT resolved automatically by this application.
# See specs-careeros/ENVIRONMENT_VARIABLES.md for loading and tracing rules.
APP_ENV=staging
DATABASE_URL=postgresql+psycopg://REPLACE_WITH_STAGING_DB_USER:REPLACE_WITH_URL_ENCODED_STAGING_DB_PASSWORD@REPLACE_WITH_STAGING_DB_HOST:REPLACE_WITH_STAGING_DB_PORT/REPLACE_WITH_STAGING_DB_NAME?sslmode=require
# Supabase project: careeros-staging. Copy connection details from this project, not API keys.
# Select direct/session connection and TLS/certificate requirements before deployment.
# Percent-encode reserved characters in the DB username/password.

API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://REPLACE_WITH_VM_PUBLIC_IP:REPLACE_WITH_STAGING_FRONTEND_PORT"]
ALLOW_LOCAL_IDENTITY=false
# Staging/prod: current local-only get_actor returns 401; real auth is still pending.
REQUIRE_PROFILE_VERSION=false
JOB_MATCHING_ENABLED=false

# Current embedded agent worker topology; dedicated worker split is NOT implemented here.
AGENT_RUNTIME_ALLOWED=true
AGENT_WORKER_EMBEDDED=true
AGENT_ENABLED=false
AGENT_INTERNAL_WRITES_ENABLED=false
AGENT_APPROVALS_ENABLED=false
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TURNS=8
AGENT_TIMEOUT_SECONDS=90
# Optional: enable only after configuring and reviewing the provider.
# LLM_BASE_URL=https://REPLACE_WITH_PROVIDER_HOST/v1
# LLM_MODEL=REPLACE_WITH_MODEL_NAME
# LLM_API_KEY=REPLACE_WITH_STAGING_LLM_API_KEY

# Stable, environment-specific Fernet key from your vault.
# Required for encrypted provider data outside development/test.
PROVIDER_ENCRYPTION_KEY=REPLACE_WITH_STAGING_FERNET_KEY
# Local default is <backend>/.private-documents. Container path must match a persistent mount.
DOCUMENT_STORAGE_DIR=/data/careeros/documents
DOCUMENT_MAX_BYTES=10485760

# Current LOCAL SUBPROCESS adapter; paths cannot address another container.
# Separate crawler container integration must be decided before Compose.
# CRAWLER_ROOT=REPLACE_WITH_ABSOLUTE_CRAWLER_REPO_PATH
# CRAWLER_PYTHON=REPLACE_WITH_ABSOLUTE_CRAWLER_PYTHON_PATH
CRAWLER_BROWSER_MODE=headless
CRAWLER_RUN_TIMEOUT_SECONDS=3600
CRAWLER_LEASE_SECONDS=30

# RESERVED / NOT READ by current backend Settings. Leave commented.
# A Supabase PostgreSQL connection does not require these API/Auth settings.
# SUPABASE_URL=https://REPLACE_WITH_STAGING_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
# SUPABASE_SECRET_KEY=REPLACE_WITH_STAGING_SERVER_ONLY_SECRET_KEY
# SUPABASE_JWKS_URL=https://REPLACE_WITH_STAGING_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
